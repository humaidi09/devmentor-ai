# =====================================================================
# DevMentor AI — root reference for environment variables
# Copy the relevant blocks into apps/web/.env.local and apps/api/.env
# NEVER commit real .env files. All services below have free tiers.
# The app runs fully in DEMO MODE with NO secrets set.
# =====================================================================

# ---------------------------------------------------------------------
# Supabase (https://supabase.com — free tier)
# ---------------------------------------------------------------------
# Public (safe to expose to the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Server-only (NEVER expose to the browser / Next.js public env)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret   # Project Settings > API > JWT Secret

# ---------------------------------------------------------------------
# Backend behaviour
# ---------------------------------------------------------------------
# DEMO_MODE=true makes the API run with a stubbed user + mock data and
# no external services. Set to false once real keys are configured.
DEMO_MODE=true
API_CORS_ORIGINS=http://localhost:3000
CRON_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------
# Google Gemini (https://aistudio.google.com — free tier). Optional.
# If unset, the AI layer returns clearly-labelled mock responses.
# ---------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------
# Email fallback — Resend (https://resend.com — free tier). Optional.
# If unset, email notifications are logged but not sent.
# ---------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=DevMentor AI <onboarding@resend.dev>

# ---------------------------------------------------------------------
# Firebase Cloud Messaging (web push). Optional.
# ---------------------------------------------------------------------
FCM_SERVER_KEY=
NEXT_PUBLIC_FIREBASE_CONFIG=

# ---------------------------------------------------------------------
# Frontend (apps/web/.env.local) — only NEXT_PUBLIC_* reach the browser
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
