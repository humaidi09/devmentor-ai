# DevMentor AI API — copy to apps/api/.env
# Runs fully in DEMO MODE with everything below left blank.

DEMO_MODE=true
ENVIRONMENT=development
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000
CRON_SECRET=change-me-to-a-long-random-string

# Supabase (leave blank for demo mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Gemini (optional — mock responses used if blank)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Email via Resend (optional)
RESEND_API_KEY=
EMAIL_FROM=DevMentor AI <onboarding@resend.dev>
