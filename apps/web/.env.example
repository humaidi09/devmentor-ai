# Close AI — environment
# Leave Supabase blank to run in DEMO MODE (no account/keys needed).

# Supabase (optional for demo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Force demo mode even if Supabase is set (true/false)
NEXT_PUBLIC_DEMO_MODE=true

# Server-only (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (optional; a safe mock is used when unset)
AI_PROVIDER=mock
GEMINI_API_KEY=
