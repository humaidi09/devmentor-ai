# Default: fictional demo; no backend credentials required.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_ACCOUNT_MODE_ENABLED=false

# To enable account mode, set both public Supabase values, DEMO_MODE=false,
# and ACCOUNT_MODE_ENABLED=true,
# apply all migrations and configure Auth before building/deploying.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# No service-role, AI, Codeforces or notification-provider key is used in Phase 3.

# Canonical HTTPS website origin in account deployments (used for auth/CSRF/redirects).
# Local tests omit it and use the incoming loopback host.
CLOSE_AI_SITE_URL=
